# Copy this file to .env and fill in your Atlas credentials locally.
# Never commit .env or paste your connection string into chat.
MONGODB_URI=
MONGODB_DB_NAME=

# Random server-only secret, at least 32 characters. Never expose it publicly.
BETTER_AUTH_SECRET=
# Exact origin, e.g. http://localhost:3000 locally or your HTTPS deployment URL.
BETTER_AUTH_URL=

# Server-only OpenAI credentials. Do not use NEXT_PUBLIC_ for this key.
OPENAI_API_KEY=
# Approved starting model; change only after checking quality and API access.
OPENAI_MODEL=gpt-4.1-mini
