{
  "name": "company-a-showroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --import tsx scripts/seed-database.ts",
    "test": "node --import tsx --test src/features/*/*.test.ts",
    "db:setup": "node --import tsx scripts/setup-database.ts",
    "db:check": "node --import tsx scripts/check-database.ts",
    "auth:setup": "node --import tsx scripts/setup-auth.ts",
    "auth:role": "node --import tsx scripts/set-user-role.ts",
    "auth:check": "node --conditions=react-server --import tsx scripts/check-auth.ts",
    "auth:link-consultant": "node --import tsx scripts/link-consultant.ts",
    "bookings:check": "node --conditions=react-server --import tsx scripts/check-bookings.ts",
    "db:diagnose": "node --import tsx scripts/diagnose-database.ts",
    "ai:check": "node --conditions=react-server --import tsx scripts/check-ai.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.18",
    "better-auth": "1.7.18",
    "dotenv": "18.0.9",
    "mongodb": "7.8.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
